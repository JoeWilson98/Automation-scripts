import pandas as pd

#load the excel file
df = pd.read_excel("file path") #requires changing to the excel file path
#remove duplicates
df = df.drop_duplicates()
#remove all empty columns
df = df.dropna(axis=1, how="all")
#remove all empty rows
df = df.dropna(how="all")
#get rid of spaces in columns and replace with _
df.columns = (
    df.columns
      .str.strip()
      .str.lower()
      .str.replace(" ", "_")
)
#collate columns one and two in a new column
df['new_column'] = df['column1'] + df['column2']

#standardise text format
df["name"] = df["name"].str.title()
df["email"] = df["email"].str.lower()
